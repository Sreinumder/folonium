       <widget class="QWidget" name="Engine">
        <attribute name="title">
         <string>Engine</string>
        </attribute>
        <layout class="QVBoxLayout" name="engineLayout">
         <item>
          <widget class="QLabel" name="engineInfoLabel">
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Polonium tiles with one engine. Layouts come from a small slicing grammar: &lt;code&gt;[ ]&lt;/code&gt; puts windows side by side in columns, &lt;code&gt;/ /&lt;/code&gt; stacks them in rows, and a number is that many windows stacked along the other axis. For example, &lt;code&gt;[1 2]&lt;/code&gt; is one window beside a column of two.&lt;/p&gt;&lt;p&gt;Add custom layouts in the tabs below. Each tab is a layout set: write one or more layouts separated by spaces or newlines. L1 is the default set; pick another set from the layout menu. The largest layout in the set that fits the open windows is used; extra windows float. If no layout fits, all windows float. Split ratios are shared by every layout and live in the field above the tabs: whitespace-separated options such as &lt;code&gt;2:1 3:2 1:1 2:3 1:2&lt;/code&gt; for two-child splits and &lt;code&gt;1:1:1 2:1:1 1:2:1 1:1:2&lt;/code&gt; for three-child splits. Horizontal and vertical splits keep separate selections; cycle them from the layout menu or their shortcuts.&lt;/p&gt;&lt;p&gt;Rotations and reflections of the same layout are not duplicated. A layout tiles as many windows as it has slots; extra windows float. Per-display settings such as mirror and rotate are in the layout menu. The KWin row there switches this display to KWin's own tiling and back.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="alignment">
            <set>Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
           </property>
          </widget>
         </item>

         <item>
          <widget class="QLabel" name="customLayoutInfoLabel">
           <property name="text">
            <string>Custom layouts: each tab is a layout set. Write one or more layouts separated by spaces or newlines. L1 is the default; pick another set from the layout menu. If the selected set has no layout for the current window count, the windows stay floating.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="customRatiosLabel">
           <property name="text">
            <string>Shared split ratios. Two-child options apply to [1 1], [1 2], [1 3] and the stacks in [2 2]; three-child options apply to [1 1 1] and the stack in [1 3].</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
